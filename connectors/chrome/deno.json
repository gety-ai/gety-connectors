{
	"tasks": {
		"build": "deno run -A ../../tools/build.ts",
		"dev": "deno run -A ../../tools/build.ts --watch",
		"check": "deno task generate && deno check src/index.ts scripts/setup.ts src/gen/manifest.d.ts",
		"generate": "deno run -A ../../tools/generate-manifest-config.ts",
		"setup": "deno run -A scripts/setup.ts",
		"test": "deno test --allow-env=TMPDIR,TMP,TEMP --allow-read --allow-write src",
		"runner": "deno task build && deno run -A --env-file=.env ../../tools/dev-runner.ts",
		"fix": "deno task fmt && deno task lint:fix",
		"fmt": "deno fmt",
		"fmt:check": "deno fmt --check",
		"lint": "deno lint",
		"lint:fix": "deno lint --fix",
		"verify": "deno task fmt:check && deno task lint && deno task check && deno task test && deno task build"
	},
	"fmt": {
		"useTabs": true,
		"indentWidth": 2,
		"singleQuote": true,
		"lineWidth": 80,
		"exclude": [
			"dist/"
		]
	},
	"lint": {
		"include": [
			"src/",
			"scripts/"
		],
		"exclude": [
			"dist/"
		],
		"rules": {
			"tags": [
				"recommended"
			]
		}
	}
}
