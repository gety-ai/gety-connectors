{
	"name": "@gety-connectors/chrome",
	"version": "0.1.0",
	"description": "Indexes Google Chrome bookmarks and browsing history from a local Chrome profile.",
	"license": "Apache-2.0",
	"keywords": [
		"gety",
		"gety-connector"
	],
	"homepage": "https://github.com/gety-ai/gety-connectors/tree/main/connectors/chrome#readme",
	"bugs": "https://github.com/gety-ai/gety-connectors/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/gety-ai/gety-connectors.git",
		"directory": "connectors/chrome"
	},
	"files": [
		"dist/main.js",
		"dist/main.js.map",
		"assets/chrome.svg",
		"CHANGELOG.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"gety": {
		"id": "chrome",
		"name": "Google Chrome",
		"version": "0.1.0",
		"min_gety_app_version": "0.6.3",
		"entry": "dist/main.js",
		"icon": "assets/chrome.svg",
		"description": "Indexes Google Chrome bookmarks and browsing history from a local Chrome profile.",
		"author": {
			"name": "yuche"
		},
		"capabilities": [
			"data-source"
		],
		"permissions": {
			"read": [
				{
					"path": "~/.config/google-chrome/Default",
					"os": [
						"linux"
					]
				},
				{
					"path": "~/Library/Application Support/Google/Chrome/Default",
					"os": [
						"macos"
					]
				},
				{
					"path": "~/AppData/Local/Google/Chrome/User Data/Default",
					"os": [
						"windows"
					]
				}
			]
		},
		"schedule": {
			"strategy": "interval",
			"interval_seconds": 3600
		},
		"doc_link": {
			"kind": "url",
			"field": "url"
		},
		"schema": {
			"extra_gety_indexed_fields": [
				{
					"field": "folder",
					"strategy": "fast_text"
				}
			]
		},
		"config": {
			"fields": [
				{
					"id": "index_bookmarks",
					"title": "Index bookmarks",
					"type": "checkbox",
					"required": false,
					"default_value": true,
					"description": "Index entries from the Bookmarks file."
				},
				{
					"id": "index_history",
					"title": "Index browsing history",
					"type": "checkbox",
					"required": false,
					"default_value": true,
					"description": "Index visited pages from the History database."
				},
				{
					"id": "history_range",
					"title": "History time range",
					"type": "dropdown",
					"required": true,
					"default_value": "90d",
					"description": "How far back to index browsing history. Pick the time window to index — only pages visited within it are indexed.",
					"options": [
						{
							"value": "7d",
							"label": "Last 7 days"
						},
						{
							"value": "30d",
							"label": "Last 30 days"
						},
						{
							"value": "90d",
							"label": "Last 90 days"
						},
						{
							"value": "365d",
							"label": "Last year"
						},
						{
							"value": "all",
							"label": "All history"
						}
					]
				},
				{
					"id": "history_skip_non_web",
					"title": "Skip non-web history URLs",
					"type": "checkbox",
					"required": false,
					"default_value": true,
					"description": "Skip history entries that are not http(s) URLs (e.g. chrome://, file://, about:)."
				}
			]
		}
	}
}
