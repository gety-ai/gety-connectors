# Claude Code
#
# By default the connector reads Claude Code chat sessions from the
# platform-default projects directory:
#   Linux/macOS: ~/.claude/projects
#   Windows:     %USERPROFILE%\.claude\projects
#
# Optional: override the projects directory by setting PROJECTS_DIR
# (GETY_CONFIG_PROJECTS_DIR also works). Leave it unset/empty to use the
# auto-detected default.
# PROJECTS_DIR=
#
# Include Claude Code subagent/workflow JSONL logs. Defaults to false.
# INCLUDE_SUBAGENTS=false
