{
	"imports": {
		"@linear/sdk": "npm:@linear/sdk@86.0.0",
		"mdast-util-from-markdown": "npm:mdast-util-from-markdown@^2.0.3",
		"mdast-util-to-markdown": "npm:mdast-util-to-markdown@^2.1.2",
		"mdast": "npm:@types/mdast@^4.0.4"
	},
	"tasks": {
		"build": "deno run -A ../../tools/build.ts",
		"dev": "deno run -A ../../tools/build.ts --watch",
		"check": "deno task generate && deno check src/index.ts src/issue.ts src/comment.ts src/markdown.ts src/utils.ts scripts/setup.ts src/gen/manifest.d.ts",
		"generate": "deno run -A ../../tools/generate-manifest-config.ts",
		"setup": "deno run -A scripts/setup.ts",
		"test": "deno test src",
		"runner": "deno task build && deno run -A --env-file=.env ../../tools/dev-runner.ts",
		"fix": "deno task fmt && deno task lint:fix",
		"fmt": "deno fmt",
		"fmt:check": "deno fmt --check",
		"lint": "deno lint",
		"lint:fix": "deno lint --fix",
		"verify": "deno task fmt:check && deno task lint && deno task check && deno task test && deno task build"
	},
	"fmt": {
		"useTabs": true,
		"indentWidth": 2,
		"singleQuote": true,
		"lineWidth": 80,
		"exclude": [
			"dist/"
		]
	},
	"lint": {
		"include": [
			"src/",
			"scripts/"
		],
		"exclude": [
			"dist/"
		],
		"rules": {
			"tags": [
				"recommended"
			]
		}
	}
}
