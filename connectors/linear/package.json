{
	"name": "@gety-connectors/linear",
	"version": "0.2.1",
	"description": "Indexes Linear issues as searchable markdown documents.",
	"license": "Apache-2.0",
	"keywords": [
		"gety",
		"gety-connector"
	],
	"homepage": "https://github.com/gety-ai/gety-connectors/tree/main/connectors/linear#readme",
	"bugs": "https://github.com/gety-ai/gety-connectors/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/gety-ai/gety-connectors.git",
		"directory": "connectors/linear"
	},
	"files": [
		"dist/main.js",
		"dist/main.js.map",
		"assets/linear.webp",
		"CHANGELOG.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"gety": {
		"id": "linear",
		"name": "Linear",
		"version": "0.2.1",
		"min_gety_app_version": "0.6.5",
		"entry": "dist/main.js",
		"icon": "assets/linear.webp",
		"description": "Indexes Linear issues as searchable markdown documents.",
		"author": {
			"name": "Gety"
		},
		"capabilities": [
			"data-source"
		],
		"schedule": {
			"strategy": "interval",
			"interval_seconds": 300
		},
		"permissions": {
			"net": [
				"api.linear.app"
			]
		},
		"config": {
			"fields": [
				{
					"id": "api_key",
					"title": "Linear API key",
					"type": "password",
					"description": "Create a personal API key in Linear settings.",
					"required": true
				},
				{
					"id": "index_comments",
					"title": "Index comments",
					"type": "checkbox",
					"description": "Append Linear issue comments to each issue markdown document.",
					"default_value": true
				}
			]
		},
		"doc_link": {
			"kind": "url",
			"field": "url"
		}
	}
}
