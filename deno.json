{
	"workspace": [
		"./connectors/linear",
		"./connectors/codex",
		"./connectors/claude-code",
		"./connectors/chrome",
		"./connectors/notion",
		"./connectors/lark"
	],
	"nodeModulesDir": "none",
	"imports": {
		"@gety-ai/connector-sdk": "./vendor/gety-deno/sdk/src/mod.ts",
		"@luca/esbuild-deno-loader": "jsr:@luca/esbuild-deno-loader@^0.11.1",
		"@std/encoding": "jsr:@std/encoding@^1.0.10",
		"@std/tar": "jsr:@std/tar@^0.1.10",
		"esbuild": "npm:esbuild@^0.24.2",
		"fast-png": "npm:fast-png@8.0.0"
	},
	"tasks": {
		"sync": "deno run --allow-read --allow-write scripts/sync.ts",
		"sync:check": "deno run --allow-read scripts/sync.ts --check",
		"sync-sdk": "deno run --allow-read --allow-write --allow-run tools/sync-sdk.ts",
		"sync-sdk:check": "deno run --allow-read tools/sync-sdk.ts --check",
		"check:tools": "deno check tools/ vendor/gety-deno/host/runner.ts",
		"test:tools": "deno test --allow-read --allow-write --allow-run tools/",
		"catalog": "deno run --allow-read scripts/catalog.ts",
		"verify:packs": "deno run --allow-read --allow-write --allow-run scripts/verify-packs.ts",
		"version-packages": "deno run --allow-read --allow-write --allow-run scripts/version.ts"
	},
	"fmt": {
		"useTabs": true,
		"indentWidth": 2,
		"singleQuote": true,
		"lineWidth": 80,
		"exclude": [
			"**/dist/",
			"node_modules/",
			"**/CHANGELOG.md",
			"pnpm-lock.yaml",
			".changeset/*.md",
			"vendor/gety-deno/"
		]
	},
	"lint": {
		"include": [
			"scripts/",
			"tools/"
		],
		"rules": {
			"tags": [
				"recommended"
			]
		}
	}
}
