{
	"workspace": [
		"./connectors/linear",
		"./connectors/codex",
		"./connectors/claude-code",
		"./connectors/chrome",
		"./connectors/notion",
		"./connectors/lark"
	],
	"nodeModulesDir": "none",
	"lint": {
		"include": [
			"scripts/"
		],
		"rules": {
			"tags": [
				"recommended"
			]
		}
	},
	"fmt": {
		"useTabs": true,
		"indentWidth": 2,
		"singleQuote": true,
		"lineWidth": 80,
		"exclude": [
			"**/dist/",
			"node_modules/",
			"**/CHANGELOG.md",
			"pnpm-lock.yaml",
			".changeset/*.md"
		]
	}
}
