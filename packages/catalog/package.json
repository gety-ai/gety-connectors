{
	"name": "@gety-connectors/catalog",
	"version": "0.1.0",
	"description": "Catalog of the official Gety connectors.",
	"license": "Apache-2.0",
	"keywords": [
		"gety"
	],
	"homepage": "https://github.com/gety-ai/gety-connectors/tree/main/packages/catalog#readme",
	"bugs": "https://github.com/gety-ai/gety-connectors/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/gety-ai/gety-connectors.git",
		"directory": "packages/catalog"
	},
	"files": [
		"CHANGELOG.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"getyCatalog": {
		"schemaVersion": 1,
		"connectors": [
			{
				"package": "@gety-connectors/chrome",
				"name": "Google Chrome",
				"description": "Indexes Google Chrome bookmarks and browsing history from a local Chrome profile.",
				"icon": "data:image/png;base64,"
			},
			{
				"package": "@gety-connectors/claude-code",
				"name": "Claude Code",
				"description": "Search your local Claude Code sessions in Gety.",
				"icon": "data:image/svg+xml;base64,"
			},
			{
				"package": "@gety-connectors/codex",
				"name": "Codex",
				"description": "Indexes local Codex session JSONL logs as searchable markdown documents.",
				"icon": "data:image/svg+xml;base64,"
			},
			{
				"package": "@gety-connectors/lark",
				"name": "Feishu",
				"description": "通过本机已登录的 lark-cli 索引飞书云文档与聊天记录。",
				"icon": "data:image/png;base64,"
			},
			{
				"package": "@gety-connectors/linear",
				"name": "Linear",
				"description": "Indexes Linear issues as searchable markdown documents.",
				"icon": "data:image/webp;base64,"
			},
			{
				"package": "@gety-connectors/notion",
				"name": "Notion",
				"description": "Indexes Notion pages shared with your integration and converts them to Markdown.",
				"icon": "data:image/png;base64,"
			}
		]
	}
}
